# ==========================================================================
# 企业私有化多场景智能 RAG-Agent 统一知识库平台 - 环境变量示例
# 使用方法：cp .env.example .env  然后填入你的 API Key
# ==========================================================================

# --- Django 基础 ---
DEBUG=1
SECRET_KEY=change-me-please-in-production-generate-a-real-secret-key
ALLOWED_HOSTS=*

# --- 数据库（PostgreSQL 16 + pgvector）---
POSTGRES_DB=rag_agent
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=rag_pass_2026
PG_DB_HOST=localhost
PG_DB_PORT=5432
PG_DB_DATABASE=rag_agent
PG_DB_USER=rag_user
PG_DB_PASSWORD=rag_pass_2026
PG_CONN_MAX_AGE=600

# --- Redis（缓存 / 短时记忆 / Celery broker）---
REDIS_DB_HOST=localhost
REDIS_DB_PORT=6379
REDIS_DB_PASSWORD=
REDIS_DB_DB=0

# --- LLM 配置（支持双模型）---
# LLM_BASE_MODEL: 基础模型（用于简单任务，节约token，速度快）
# LLM_ADVANCED_MODEL: 高级模型（用于复杂任务，推理能力强）
# 当前使用 DeepSeek，可通过修改 URL + Model 切换其他平台
LLM_API_KEY=sk-your-llm-api-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_BASE_MODEL=deepseek-v4-flash         # 基础模型（推荐：deepseek-v4-flash）
LLM_ADVANCED_MODEL=deepseek-v4-pro    # 高级模型（推荐：deepseek-v4-pro）
LLM_TIMEOUT=60

# --- Agent 配置（Agentic RAG 工具调用）---
# TAVILY_API_KEY: 联网搜索工具 API Key（https://tavily.com，免费 1000 次/月）
# 未配置时自动降级到 DuckDuckGo（免费，但质量一般）
TAVILY_API_KEY=
# BUSINESS_DB_DSN: Text2SQL 业务数据库连接串
# 格式：postgresql://user:pass@host:port/dbname
BUSINESS_DB_DSN=
# BUSINESS_DB_TABLES: Text2SQL 可查询表白名单（逗号分隔，空=public schema 全部表）
# 生产环境建议配置白名单，如：user_account,user_department,user_team
BUSINESS_DB_TABLES=
# AGENT_DEFAULT_MODE: 默认问答模式
# auto: Agent 模式，LLM 自主决定是否调用工具（默认）
# rag:  传统 RAG 模式，预检索 + LLM 生成
# agent: 强制 Agent 模式
AGENT_DEFAULT_MODE=auto

# --- Embedding & Rerank 配置（通用变量，支持切换平台）---
# 当前使用 SiliconFlow，可通过修改 URL + Model 切换其他平台
EMBEDDING_API_KEY=sk-your-embedding-api-key-here
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# --- Embedding Provider 切换开关 ---
# docker: 优先使用 Docker Embedding 服务（本地部署）, API兜底
# api:    优先使用云 API（如 SiliconFlow）, 本地docker兜底
EMBEDDING_PROVIDER=docker

# --- Docker Embedding 配置（预留，本地部署时使用）---
# EMBEDDING_DOCKER_URL=http://localhost:8080/embed
# EMBEDDING_DOCKER_TIMEOUT=30

# --- 图片存储模式 ---
# base64: 开发环境 - 图片直接以 base64 存 PG
# oss:    生产环境 - 走 OSS/MinIO
IMAGE_STORAGE_MODE=base64

# --- 文档存储配置 ---
DOCUMENT_STORAGE_MODE=local          # local / oss
DOCUMENT_RETENTION_ENABLED=1         # 是否保留原始文件（1保留/0删除）
DOCUMENT_MAX_SIZE_MB=100             # 单个文件最大大小（MB）

# --- OSS 配置（DOCUMENT_STORAGE_MODE=oss 时必填）---
# OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
# OSS_ACCESS_KEY_ID=your-access-key-id
# OSS_ACCESS_KEY_SECRET=your-access-key-secret
# OSS_BUCKET_NAME=your-bucket-name
# OSS_REGION=oss-cn-hangzhou

# --- 时区 ---
TZ=Asia/Shanghai

# --- 邮件服务（SMTP）---
# 用于密码重置等功能；EMAIL_ENABLED=0 时邮件输出到控制台（开发用）
EMAIL_ENABLED=0
EMAIL_HOST=smtp.example.com
EMAIL_PORT=465
EMAIL_USE_SSL=1
EMAIL_USE_TLS=0
EMAIL_HOST_USER=noreply@example.com
EMAIL_HOST_PASSWORD=your-smtp-password
EMAIL_FROM=noreply@example.com
# 密码重置链接有效期（秒），默认300（5 分钟）
PASSWORD_RESET_TIMEOUT=300
# 前端基础地址（用于拼接重置密码页面链接）
FRONTEND_BASE_URL=http://localhost:8080

# --- Analytics 配置 ---
ANALYTICS_REDIS_DB=3                        # Analytics 专用 Redis DB（默认 3，避免与 Celery broker=DB1/result_backend=DB2 冲突）

# --- 忠实度评估（回答质量检测，成本敏感）---
FAITHFULNESS_ENABLED=1                     # 是否启用总开关（0=关闭节省成本）
FAITHFULNESS_BATCH_SIZE=50                 # 每小时最多评估条数
FAITHFULNESS_DAILY_LIMIT=500               # 每日评估总量上限
FAITHFULNESS_MODEL=deepseek-chat           # 评估所用模型（便宜模型）
FAITHFULNESS_COST_LIMIT=1.0                # 每日成本上限（元）

# --- 队列监控 ---
QUEUE_MONITOR_ENABLED=1                    # 是否启用队列深度监控（0/1）
