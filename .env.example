# ==========================================================================
# 企业私有化多场景智能 RAG-Agent 统一知识库平台 - 环境变量示例
# 使用方法：cp .env.example .env  然后填入你的 API Key
# ==========================================================================

# --- Django 基础 ---
DEBUG=1
SECRET_KEY=change-me-please-in-production-generate-a-real-secret-key
ALLOWED_HOSTS=*

# --- 数据库（PostgreSQL 16 + pgvector）---
POSTGRES_DB=rag_agent
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=rag_pass_2026

# --- Redis（缓存 / 短时记忆 / Celery broker）---
# 内部使用 redis:6379，外部映射到宿主机同端口

# --- LLM: DeepSeek 公有 API（默认，OpenAI 兼容协议）---
# 申请：https://platform.deepseek.com/api_keys
LLM_API_KEY=sk-your-deepseek-api-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# --- Embedding & Rerank: SiliconFlow（免费额度）---
# 申请：https://cloud.siliconflow.cn/account/ak
SILICONFLOW_API_KEY=sk-your-siliconflow-api-key-here
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# --- LLM Provider 切换开关 ---
# 可选：deepseek / qwen / glm / vllm / ollama
LLM_PROVIDER=deepseek

# --- 图片存储模式 ---
# base64: 开发环境 - 图片直接以 base64 存 PG
# oss:    生产环境 - 走 OSS/MinIO（v1 stub 未完整实现）
IMAGE_STORAGE_MODE=base64

# --- 文档存储配置 ---
DOCUMENT_STORAGE_MODE=local          # local / oss
DOCUMENT_RETENTION_ENABLED=1         # 是否保留原始文件（1保留/0删除）
DOCUMENT_MAX_SIZE_MB=100             # 单个文件最大大小（MB）

# --- OSS 配置（DOCUMENT_STORAGE_MODE=oss 时必填）---
# OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
# OSS_ACCESS_KEY_ID=your-access-key-id
# OSS_ACCESS_KEY_SECRET=your-access-key-secret
# OSS_BUCKET_NAME=your-bucket-name
# OSS_REGION=oss-cn-hangzhou

# --- 时区 ---
TZ=Asia/Shanghai
