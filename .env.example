# ==========================================================================
# 企业私有化多场景智能 RAG-Agent 统一知识库平台 - 环境变量示例
#
# 本文件仅保留「启动期必填」和「敏感凭证」两类配置：
#   1. 启动期必填：Django/DB/Redis 连接信息，settings.py 加载时就要用
#   2. 敏感凭证：API Key / 密码 / DSN 等，不进数据库

# 使用方法：cp .env.example .env  然后填入你的 API Key
# 首次部署：python scripts/init_system.py  （写入 SystemConfig 默认值）
# ==========================================================================

# --- Django 基础 ---
DEBUG=1
SECRET_KEY=change-me-please-in-production-generate-a-real-secret-key
ALLOWED_HOSTS=*

# --- 数据库（PostgreSQL 16 + pgvector）---
# 鸡生蛋问题：连 DB 前就要用，不能放 SystemConfig
POSTGRES_DB=rag_agent
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=rag_pass_2026
PG_DB_HOST=localhost
PG_DB_PORT=5432
PG_DB_DATABASE=rag_agent
PG_DB_USER=rag_user
PG_DB_PASSWORD=rag_pass_2026
PG_CONN_MAX_AGE=600

# --- Redis（缓存 / 短时记忆 / Celery broker）---
REDIS_DB_HOST=localhost
REDIS_DB_PORT=6379
REDIS_DB_PASSWORD=
REDIS_DB_DB=0

# --- LLM 配置 ---
LLM_API_KEY=sk-your-llm-api-key-here

# --- Agent 配置（Agentic RAG 工具调用）---
# TAVILY_API_KEY: 联网搜索工具 API Key（https://tavily.com，免费 1000 次/月）
# 未配置时自动降级到 DuckDuckGo（免费，但质量一般）
TAVILY_API_KEY=
# BUSINESS_DB_DSN: Text2SQL 业务数据库连接串（含密码，敏感凭证保留 .env）
# 格式：postgresql://user:pass@host:port/dbname
BUSINESS_DB_DSN=

# --- Embedding & Rerank 配置 ---
# API Key 仍保留在 .env（敏感凭证）
EMBEDDING_API_KEY=sk-your-embedding-api-key-here

# --- OSS 配置（DOCUMENT_STORAGE_MODE=oss 时使用）---
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret

# --- 时区 ---
TZ=Asia/Shanghai

# --- 邮件服务（SMTP）---
EMAIL_HOST_PASSWORD=your-smtp-password
